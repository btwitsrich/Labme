{
  "manifest_version": 3,
  "name": "PhishGuard — Zero-Day Phishing Prevention",
  "version": "2.0.0",
  "description": "Real-time phishing detection using DistilBERT NLP, MobileNetV2 vision AI, and LIME explainability. Protects against zero-day phishing attacks.",

  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "notifications",
    "webNavigation",
    "scripting",
    "alarms"
  ],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PhishGuard"
  },

  "options_page": "options/options.html",

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["warning/warning.html", "icons/*.png"],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
